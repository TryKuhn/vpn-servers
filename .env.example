# ---------------------------------------------------------------------------
# TryKuhn VPN v0.1 async stack
# Copy to .env on the server and edit before make bootstrap/make up.
# ---------------------------------------------------------------------------

# Images
POSTGRES_VERSION=16-alpine
HAPROXY_VERSION=3.0-alpine
XRAY_VERSION=latest
HYSTERIA_VERSION=latest

# Domains
PUBLIC_DOMAIN=trykuhn.xyz
SUB_DOMAIN=trykuhn.xyz
NAIVE_DOMAIN=nv.trykuhn.xyz
HYSTERIA_DOMAIN=hy.trykuhn.xyz

# Public ports
PUBLIC_TCP_PORT=443
PUBLIC_UDP_PORT=443

# Internal service ports
XRAY_LISTEN_PORT=1443
NAIVE_LISTEN_PORT=2443
MANAGER_PORT=8080

# TLS cert paths inside containers. scripts/issue-certs-standalone.sh writes certs/fullchain.pem and certs/privkey.pem.
TLS_CERT=/certs/fullchain.pem
TLS_KEY=/certs/privkey.pem

# Xray / REALITY / XHTTP
# Run: make init
REALITY_PRIVATE_KEY=change_me
REALITY_PUBLIC_KEY=change_me
REALITY_SHORT_ID=change_me
REALITY_SNI=gateway.icloud.com
REALITY_TARGET=gateway.icloud.com:443
XHTTP_PATH=/assets/api
CLIENT_FINGERPRINT=chrome

# PostgreSQL
POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://vpn:change_me_strong_password@postgres:5432/vpn

# Manager
SUBSCRIPTION_BASE_URL=https://trykuhn.xyz/sub
SUBSCRIPTION_PROFILE_TITLE=TryKuhn VPN

# Fallback auth lines are generated when there are no active devices yet.
# Keep these random and private.
FALLBACK_AUTH_USERNAME=fallback
FALLBACK_AUTH_PASSWORD=change_me_random_fallback_password

# Cloudflare WARP proxy (for routing Anthropic/Claude traffic via residential IP).
# Install warp-cli on the host, run: warp-cli proxy enable && warp-cli connect
WARP_PROXY_HOST=host.docker.internal
WARP_PROXY_PORT=40000

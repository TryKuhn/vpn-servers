# ============================================================================
#  vpn-servers — environment configuration
# ============================================================================
#
#  Copy this file to .env and fill in your values:
#      cp .env.example .env
#
#  Then run `make init` to generate Reality keys (PRIVATE_KEY, PUBLIC_KEY,
#  SHORT_ID will be filled in automatically).
#
#  NEVER commit .env to git. It is in .gitignore.
# ============================================================================

# --- Public server identity ---------------------------------------------------

# Your VPS public IPv4. Used in VLESS links given to clients.
SERVER_IP=

# Port the VPN listens on. 443 mimics HTTPS — recommended.
SERVER_PORT=443


# --- Reality protocol settings -----------------------------------------------

# The "mask" domain. Reality proxies the TLS handshake to this real site,
# making your traffic look like a connection to it.
#
# Pick a domain that:
#   - supports TLS 1.3 + HTTP/2 (test with `make check-sni SNI=...`)
#   - is NOT blocked by your users' ISPs
#   - has plausible traffic patterns (i.e. someone might actually visit it)
#
# Recommended: gateway.icloud.com, www.yahoo.com, www.swift.com
SNI=gateway.icloud.com

# `dest` is what xray actually proxies to during the Reality handshake.
# Usually: "${SNI}:443"
DEST=gateway.icloud.com:443


# --- Cosmetics (shown in client app) -----------------------------------------

# Country flag emoji for VLESS link labels.
# 🇫🇮 Finland   🇩🇪 Germany   🇳🇱 Netherlands   🇸🇪 Sweden
COUNTRY_FLAG=🇫🇮

# Short tag used in client app entry name.
# Final label will look like: "🇫🇮 TryKuhnVpn@username"
SERVER_TAG=TryKuhnVpn


# --- Generated secrets — do NOT edit manually --------------------------------
# These are filled in by `make init` (scripts/generate-keys.sh).

PRIVATE_KEY=
PUBLIC_KEY=
SHORT_ID=
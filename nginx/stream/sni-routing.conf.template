# Route port-443 connections by TLS SNI without terminating TLS.
# The stream proxy reads the ClientHello, extracts server_name, and
# forwards the raw TCP stream to the appropriate backend.
map $ssl_preread_server_name $backend_443 {
    ${NGINX_DOMAIN}  127.0.0.1:4430;   # Nginx HTTPS — subscription + WebSocket
    default           127.0.0.1:8443;   # Xray Reality — direct VPN connection
}

server {
    listen 443;
    ssl_preread       on;
    proxy_pass        $backend_443;
    proxy_connect_timeout 10s;
    # Long timeout: VPN connections are persistent (hours, not seconds).
    proxy_timeout     86400s;
}
